   "source": [
    "\n",
    "class Solution:\n",
    "    def addDigits(self, num: int) -> int:\n",
    "        if num == 0:\n",
    "            return 0\n",
    "        return 1 + (num - 1) % 9\n",
    "\n",
    "\n",
    "num = int(input(\"Enter a number: \"))\n",
    "\n",
    "solution = Solution()\n",
    "\n",
    "result = solution.addDigits(num)\n",
    "\n",
    "print(\"Result:\", result)"
   ]
  }
 ],
