   "source": [
    "\n",
    "def climb(n):\n",
    "    if n <= 2:\n",
    "        return n\n",
    "\n",
    "    return climb(n - 1) + climb(n - 2)\n",
    "\n",
    "n = int(input(\"Enter the number of stairs: \"))\n",
    "\n",
    "result = climb(n)\n",
    "\n",
    "\n",
    "print(\"Number of ways:\", result)"
   ]
  }
