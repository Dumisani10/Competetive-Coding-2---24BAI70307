   "source": [
    "def containsDuplcates(nums,k):\n",
    "    for i in range(len(nums)):\n",
    "        for j in range(i+1,len(nums)):\n",
    "            if nums[i]==nums[j] and abs(i-j)<=k:\n",
    "                return True\n",
    "    return False\n",
    "\n",
    "\n",
    "nums= [1,0,1,1]\n",
    "k = 1\n",
    "containsDuplcates(nums,k)\n",
    "\n"
   ]
  }
 ],
